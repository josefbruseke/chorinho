# ─────────────────────────────────────────────────────────────────────────────
# Copie para .env.local e preencha. Nada aqui é secreto: são exemplos.
#
# O que tem prefixo NEXT_PUBLIC_ vai para o navegador, em texto claro. O que
# não tem, nunca sai do servidor — conferir isso antes de acrescentar variável
# é a diferença entre uma chave publicável e um vazamento.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ─────────────────────────────────────────────────────────────────
# Painel → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave publicável. O cliente do navegador usa só ela, e só lê — toda escrita
# passa por Route Handler. A RLS é quem defende o que ela alcança.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# service_role: ignora RLS inteira. Nunca com prefixo NEXT_PUBLIC_, nunca
# importada de componente de cliente (services/database/admin.ts é server-only).
SUPABASE_SECRET_KEY=sb_secret_...

# ── Passe do balcão ──────────────────────────────────────────────────────────
# Assina o QR do cliente. Mínimo 32 caracteres — o código recusa menos que isso,
# porque com segredo curto o passe é forjável e o carimbo deixa de valer.
#   openssl rand -base64 48
PASS_HMAC_SECRET=

# ── Endereço público ─────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Mapa ─────────────────────────────────────────────────────────────────────
# Em env var porque provedor de tiles muda, e porque a atribuição é exigência
# de licença do OpenStreetMap, não enfeite.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap

# ── Cobrança ─────────────────────────────────────────────────────────────────
# `manual` = a equipe libera a loja à mão. Continua existindo depois do Stripe:
# loja em teste, cortesia e caso de suporte precisam de uma saída sem cartão.
BILLING_PROVIDER=manual

# ── Modo de teste ────────────────────────────────────────────────────────────
# Abre o app de demonstração num endereço público sem deixá-lo aberto ao mundo.
CHORINHO_MODO_TESTE=false
CHORINHO_MODO_TESTE_CHAVE=
