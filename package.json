{
  "name": "chorinho",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "next dev",
    "start": "next dev",
    "build": "bun run lint && next build && serwist build",
    "serve": "next start",
    "lint": "eslint .",
    "check-types": "tsc --noEmit --incremental",
    "format": "prettier --write . '!(node_modules|.next)/**/*'",
    "sw:build": "serwist build",
    "test": "echo \"sem testes ainda — M17\" && exit 0",
    "db:types": "bunx --bun supabase@latest gen types typescript --project-id jzljyfyxybcpidvgsgaa > services/database/types.ts",
    "vercel": "vercel --build-env VERCEL_TELEMETRY_DISABLED=1",
    "vercel:login": "vercel login",
    "postinstall": "husky",
    "precommit": "lint-staged",
    "next:build": "bun run build",
    "next:lint": "bun run lint",
    "next:check-types": "bun run check-types",
    "next:format": "bun run format",
    "next:serve": "bun run serve"
  },
  "dependencies": {
    "@heroicons/react": "~2.2.0",
