    "html5-qrcode": "^2.3.8",
    "idb-keyval": "~6.3.0",
    "leaflet": "~1.9.4",
    "leaflet.markercluster": "~1.5.3",
    "next": "~16.2.4",
    "next-nprogress-bar": "~2.4.7",
    "next-themes": "~0.4.6",
