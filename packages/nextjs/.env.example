# Nenhuma destas e obrigatoria para rodar localmente com a blockchain local.

# --- Blockchain -------------------------------------------------------------
# RPC proprio em redes publicas
NEXT_PUBLIC_ALCHEMY_API_KEY=
# Conectar carteiras via WalletConnect
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=

# --- Supabase ---------------------------------------------------------------
# Painel > Project Settings > API. Use a chave PUBLISHABLE (sb_publishable_...),
# nao a secret: tudo com prefixo NEXT_PUBLIC_ vai para o navegador.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Carteira embutida (Privy) ---------------------------------------------
# Painel do Privy > App settings. Sem isso o app roda inteiro, so nao cria
# carteira -- e sem carteira nao ha endereco para receber carimbo.
#
# Do lado do Privy, em User management > Authentication > JWT integration:
#   1. Ligue "JWT-based authentication"
#   2. User ID claim:  sub
#   3. JWKS Endpoint:  https://<projeto>.supabase.co/auth/v1/.well-known/jwks.json
#   4. Authentication environment: deixe "Client side" ligado -- e o navegador
#      que repassa o token da Supabase.
#
# As checagens de aud e iss ficam opcionais no painel. Valem como endurecimento
# depois que o fluxo estiver rodando: aud = authenticated, iss = o issuer acima.
NEXT_PUBLIC_PRIVY_APP_ID=

# --- Mapa -------------------------------------------------------------------
# Tiles. Sem valor, usa o OpenStreetMap padrao -- que proibe uso comercial
# pesado, entao producao precisa de um provedor proprio aqui.
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=

# --- Torneira do ambiente de teste -------------------------------------------
# Quanto ETH de mentira cada carteira nova recebe ao ser criada. Vazio =
# desligada, que e o certo em producao.
#
# So funciona em no de desenvolvimento (anvil): `anvil_setBalance` nao existe
# numa rede publica, e ninguem cunha ETH da Sepolia -- nem nos. Ali a chamada
# vira silencio e o cadastro segue normal.
#
# O aplicativo NAO precisa disto. Nenhuma tela pede assinatura de carteira: o
# relayer paga o gas de tudo, e uma carteira com zero ETH carimba, resgata e
# conquista igual. Serve para quem for cutucar os contratos pela MetaMask.
CHORINHO_TORNEIRA_ETH=

# --- Endereco do site --------------------------------------------------------
# Onde a aplicacao responde. So importa para o metadado das pecas e dos selos,
# que e lido por carteira e marketplace -- eles nao tem como adivinhar o
# dominio. Na Vercel, sem valor aqui, cai na URL de producao do projeto; em
# desenvolvimento, no localhost. Dominio proprio precisa ser escrito aqui.
NEXT_PUBLIC_SITE_URL=
