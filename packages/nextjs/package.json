{
  "name": "@se-2/nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "bun run lint && next build",
    "check-types": "tsc --noEmit --incremental",
    "dev": "next dev",
    "format": "prettier --write . '!(node_modules|.next)/**/*'",
    "ipfs": "NEXT_PUBLIC_IPFS_BUILD=true bun run build && bunx bgipfs upload config init -u https://upload.bgipfs.com && CID=$(bunx bgipfs upload out | grep -o 'CID: [^ ]*' | cut -d' ' -f2) && [ ! -z \"$CID\" ] && echo 'Upload complete! Your site is now available at: https://community.bgipfs.com/ipfs/'$CID || echo 'Upload failed'",
    "lint": "eslint .",
    "serve": "next start",
    "start": "next dev",
    "vercel": "vercel --build-env VERCEL_TELEMETRY_DISABLED=1",
    "vercel:login": "vercel login",
    "vercel:yolo": "vercel --build-env NEXT_PUBLIC_IGNORE_BUILD_ERROR=true --build-env VERCEL_TELEMETRY_DISABLED=1"
  },
  "dependencies": {
    "@heroicons/react": "~2.2.0",
    "@rainbow-me/rainbowkit": "2.2.11",
    "@react-native-async-storage/async-storage": "~3.1.1",
    "@scaffold-ui/components": "^0.1.12",
    "@scaffold-ui/debug-contracts": "^0.1.11",
    "@scaffold-ui/hooks": "^0.1.8",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "@tanstack/react-query": "~5.102.8",
    "@uniswap/sdk-core": "^7.19.2",
    "@uniswap/v2-sdk": "^4.21.3",
    "blo": "~2.0.0",
    "burner-connector": "0.0.21",
    "daisyui": "5.7.37",
    "html5-qrcode": "^2.3.8",
    "kubo-rpc-client": "~7.1.0",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "next": "~16.3.4",
    "next-nprogress-bar": "~3.0.0",
    "next-themes": "~0.4.6",
    "qrcode.react": "~4.2.0",
    "react": "~19.3.0",
    "react-dom": "~19.3.0",
    "react-hot-toast": "~2.6.0",
    "react-leaflet": "^5.0.0",
    "usehooks-ts": "~3.1.1",
    "viem": "2.56.3",
    "wagmi": "3.7.7",
    "zustand": "~5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@trivago/prettier-plugin-sort-imports": "~6.0.2",
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "~26.5.1",
    "@types/react": "~19.3.0",
    "@types/react-dom": "^19.3.0",
    "abitype": "1.3.0",
    "bgipfs": "~0.1.0",
    "eslint": "~10.10.0",
    "eslint-config-next": "~16.3.4",
    "eslint-config-prettier": "~10.1.8",
    "eslint-plugin-prettier": "~5.5.6",
    "postcss": "~8.5.28",
    "prettier": "~3.9.6",
    "tailwindcss": "4.3.3",
    "type-fest": "~5.9.0",
    "typescript": "~7.0.2",
    "vercel": "~59.16.0"
  }
}
